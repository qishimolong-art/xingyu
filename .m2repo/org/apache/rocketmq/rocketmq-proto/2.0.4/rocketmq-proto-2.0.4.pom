    <scm>
        <connection>PROJECT_URL</connection>
        <developerConnection>PROJECT_URL</developerConnection>
        <tag>2.0.4</tag>
        <url>PROJECT_URL</url>
    </scm>

    <developers>
        
    </developers>

    <groupId>org.apache.rocketmq</groupId>
    <artifactId>rocketmq-proto</artifactId>
    <version>2.0.4</version>

